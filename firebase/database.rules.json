{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('host').val() === auth.uid || (!data.exists() && newData.child('host').val() === auth.uid))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 30"
          }
        },
        "answers": {
          "$q": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($room).child('state/phase').val() === 'question' && root.child('rooms').child($room).child('state/key').val() === $q",
              ".validate": "newData.child('c').isNumber() && newData.child('t').val() === now"
            }
          }
        }
      }
    }
  }
}
